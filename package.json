{
  "name": "lightline-compare",
  "version": "1.1.0",
  "private": true,
  "description": "Before/after image comparison with accounts and a folder archive, on Cloudflare Pages.",
  "scripts": {
    "schema:local": "wrangler d1 execute lightline --local --persist-to=./.wrangler-test --file=./schema.sql",
    "schema:remote": "wrangler d1 execute lightline --remote --file=./schema.sql",
    "dev": "wrangler pages dev --persist-to=./.wrangler-test --port=8788",
    "test": "node test/api.test.mjs",
    "test:geometry": "node test/geometry.test.mjs",
    "deploy": "wrangler pages deploy"
  },
  "devDependencies": {
    "wrangler": "^4.42.0",
    "playwright": "^1.49.1"
  }
}
